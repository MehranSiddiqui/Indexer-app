
generator client{
    provider="prisma-client"
    output="../src/generated/prisma"
}

datasource db{
    provider = "postgresql"
}

enum UrlStatus {
  Pending
  Submitted
  Failed
  Indexed
  Blocked
  Queued
}
//DB STRUCTURE FOR PROJECTS
model Project{
    id String @id @default(uuid())
    name String
    description String
    url String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//DB STRUCTURE FOR URLS
model Url{
    id String @id @default(uuid())
    userId String
    url String
    normalizedUrl String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    publishedAt DateTime?
    publishAttempts Int @default(0)
    isDeleted Boolean @default(false)
    deletedAt DateTime?
    status          UrlStatus   @default(Pending)
    statusReason    String?
    statusUpdatedAt DateTime @default(now())
    @@unique([userId, normalizedUrl])
    @@index([userId])
}